# Copy this file to `.env` and fill in your key.
# Get one at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-5      # or claude-haiku-4-5 for lower latency
# VOICEBOT_MAX_TOKENS=400            # cap on spoken reply length

# --- Free local brain (no API key needed) ---
# Set the provider to "ollama" to run a free local model instead of Claude.
# Requires Ollama (https://ollama.com) running + a pulled model.
# VOICEBOT_PROVIDER=ollama
# VOICEBOT_OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# --- Voice (text-to-speech) ---
# Parley auto-picks a female voice (prefers Enhanced/Premium if installed).
# Override with any installed system-voice name, and set the speaking rate:
# VOICEBOT_VOICE=ava          # name/id substring, e.g. ava, samantha, zoe
# VOICEBOT_RATE=188           # words per minute (lower = slower/clearer)
# VOICEBOT_STT_LANG=en-IN     # recognition language for your accent (en-US default; en-GB, en-AU, …)
